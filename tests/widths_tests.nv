// widths_tests.nv — the API suite for the width rule.
//
// Run with `--isolate` for one verdict per `@test`.
//
// Each case fixes a rule, because the width of a codepoint is the one
// thing this module does not decide. The three rules that need no
// table are asserted against what they say they answer. The Unicode
// rule is asserted against UAX #11: `世` is two cells, a combining
// acute is none, and `A` is one.

use std.test
use std.str
use widths

@test
fn test_the_monospace_rule_answers_one_to_everything() [io]
    let w = widths.monospace_width()

    test.case("ASCII")
    test.assert(widths.char_width(w, 0x41) == 1)

    test.case("and everything else, which is the placeholder's whole claim")
    test.assert(widths.char_width(w, 0x4E16) == 1)
    test.assert(widths.char_width(w, 0x0301) == 1)

@test
fn test_the_ascii_rule_gives_nothing_to_what_it_cannot_measure() [io]
    let w = widths.ascii_width()

    test.case("printable ASCII is one column")
    test.assert(widths.char_width(w, 0x41) == 1)
    test.assert(widths.char_width(w, 0x20) == 1)

    test.case("a control byte takes no space rather than one")
    test.assert(widths.char_width(w, 0x07) == 0)

    test.case("and so does everything above 126, which is only right if there is none")
    test.assert(widths.char_width(w, 0x4E16) == 0)

@test
fn test_a_fixed_rule_measures_in_whatever_the_caller_is_measuring_in() [io]
    let w = widths.fixed_width(8)

    test.case("every codepoint is the same number")
    test.assert(widths.char_width(w, 0x41) == 8)
    test.assert(widths.char_width(w, 0x4E16) == 8)

@test
fn test_a_negative_answer_is_clamped_rather_than_believed() [io]
    // A rule a caller wrote badly should make text too long, not
    // negative — the first is visible on the screen and the second is
    // an index out of range somewhere else.
    let w = widths.fixed_width(0 - 3)

    test.case("no codepoint is narrower than nothing")
    test.assert(widths.char_width(w, 0x41) == 0)

@test
fn test_a_strings_width_counts_codepoints_and_not_bytes() [io]
    let w = widths.monospace_width()

    test.case("ASCII agrees with anyone's intuition")
    test.assert(widths.str_width(w, "abc") == 3)

    test.case("and a two-byte codepoint is one column, which str.len is not")
    test.assert(widths.str_width(w, "é") == 1)

    test.case("nothing is nothing")
    test.assert(widths.str_width(w, "") == 0)

@test
fn test_a_prefix_can_be_measured_without_measuring_the_whole() [io]
    let w = widths.monospace_width()

    test.case("the first two codepoints")
    test.assert(widths.prefix_width(w, "abcdef", 2) == 2)

    test.case("none of them")
    test.assert(widths.prefix_width(w, "abcdef", 0) == 0)

    test.case("and more than there are is all of them rather than an error")
    test.assert(widths.prefix_width(w, "abc", 99) == 3)

@test
fn test_fitting_a_prefix_answers_in_bytes() [io]
    // A byte count, because that is what a caller slicing the string
    // needs — and the two differ for every string that is not ASCII.
    let w = widths.monospace_width()

    test.case("four ASCII columns are four bytes")
    test.assert(widths.fit_prefix(w, "abcdef", 4) == 4)

    test.case("a two-byte codepoint that fits contributes two bytes")
    test.assert(widths.fit_prefix(w, "ébc", 2) == 3)

    test.case("nothing fits in no columns")
    test.assert(widths.fit_prefix(w, "abc", 0) == 0)

    test.case("and everything fits in more columns than there are")
    test.assert(widths.fit_prefix(w, "abc", 99) == 3)

@test
fn test_a_codepoint_is_one_codepoint_whatever_its_length_in_bytes() [io]
    // The walk reads the UTF-8 lead byte and takes the sequence it
    // announces, so the unit is the codepoint and never the byte.
    let w = widths.monospace_width()

    test.case("a three-byte ideograph is one codepoint")
    test.assert(str.len("世") == 3)
    test.assert(widths.str_width(w, "世") == 1)

    test.case("and a four-byte emoji is one as well")
    test.assert(str.len("😀") == 4)
    test.assert(widths.str_width(w, "😀") == 1)

    test.case("a rule that answers two counts every codepoint twice")
    test.assert(widths.str_width(widths.fixed_width(2), "世界") == 4)

    test.case("and a prefix wider than the text is all of it, in bytes")
    test.assert(widths.fit_prefix(w, "éé", 99) == 4)

@test
fn test_bytes_that_are_not_utf8_are_walked_one_at_a_time() [io]
    // A walk that takes one byte where the sequence is not there
    // always makes progress, so a scan over arbitrary bytes ends.
    let w = widths.monospace_width()

    test.case("a lead byte with nothing after it measures as one")
    test.assert(widths.str_width(w, str.from_byte(0xE4)) == 1)

    test.case("and a lead byte followed by something that is not a continuation is two")
    test.assert(widths.str_width(w, str.from_byte(0xC3) + "a") == 2)

@test
fn test_the_unicode_rule_answers_uax_11() [io]
    // The rule a terminal is written against, and the one case the
    // three table-free rules cannot cover.
    let w = widths.unicode_width()

    test.case("an ideograph is two cells")
    test.assert(widths.char_width(w, 0x4E16) == 2)
    test.assert(widths.str_width(w, "世界") == 4)

    test.case("a combining mark is none")
    test.assert(widths.char_width(w, 0x0301) == 0)
    test.assert(widths.str_width(w, "é") == 1)

    test.case("and a Latin letter is one")
    test.assert(widths.char_width(w, 0x41) == 1)

    test.case("a prefix stops where the next codepoint would not fit")
    test.assert(widths.fit_prefix(w, "世界", 3) == 3)
